// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id         String   @id // server-generated public id, shown on the map
  // sha256 of the secret session token. Nullable only so the column could be
  // added to a live table; every new row sets it.
  tokenHash  String?  @unique
  lat        Float // ALREADY privacy-offset coords (raw is never stored)
  lng        Float
  busy       Boolean  @default(false) // true while in an active connection
  peerId     String? // who this user is requesting or connected to
  blockedIds String[] @default([]) // people this session blocked
  lastSeen   DateTime

  @@index([lastSeen])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}

// Request counts for the current minute, keyed like "join:<ip hash>" or
// "signal:<session id>". See lib/rate-limit.ts.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
